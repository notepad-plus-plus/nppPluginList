{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"name",
		"version",
		"arch",
		"npp-plugins"
	],
	"properties": {
		"name": {
			"const": "npp-pluginList"
		},
		"version": {
			"$ref": "#/$defs/version"
		},
		"arch": {
			"enum": ["32", "64", "arm64"]
		},
		"npp-plugins": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/plugin"
			}
		}
	},
	"$defs": {
		"version": {
			"type": "string",
			"pattern": "^\\d+(?:\\.\\d+){0,3}$"
		},
		"versionRange": {
			"type": "string",
			"pattern": "^\\[(?:\\d+(?:\\.\\d+){0,3})?,(?:\\d+(?:\\.\\d+){0,3})?\\]$"
		},
		"plugin": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"folder-name",
				"display-name",
				"version",
				"id",
				"repository",
				"description",
				"author",
				"homepage"
			],
			"properties": {
				"folder-name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"display-name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"version": {
					"$ref": "#/$defs/version"
				},
				"npp-compatible-versions": {
					"$ref": "#/$defs/versionRange"
				},
				"old-versions-compatibility": {
					"type": "string",
					"pattern": "^\\[(?:\\d+(?:\\.\\d+){0,3})?,(?:\\d+(?:\\.\\d+){0,3})?\\]\\[(?:\\d+(?:\\.\\d+){0,3})?,(?:\\d+(?:\\.\\d+){0,3})?\\]$"
				},
				"id": {
					"type": "string",
					"pattern": "^[0-9A-Fa-f]{64}$"
				},
				"repository": {
					"type": "string",
					"maxLength": 2048,
					"format": "uri",
					"pattern": "^https://"
				},
				"description": {
					"type": "string",
					"minLength": 1,
					"maxLength": 20000
				},
				"author": {
					"type": "string",
					"maxLength": 500
				},
				"homepage": {
					"oneOf": [
						{
							"const": ""
						},
						{
							"type": "string",
							"maxLength": 2048,
							"format": "uri",
							"pattern": "^https?://"
						}
					]
				}
			}
		}
	}
}
